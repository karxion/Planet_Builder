# bkend get_context 또는 콘솔이 제공하는 Service API URL (/v1 포함)
VITE_BKEND_API_URL=
VITE_BKEND_PROJECT_ID=
VITE_BKEND_ENV=dev
# Public client key only. Never use a secret/admin key in VITE_* variables.
VITE_BKEND_PUBLISHABLE_KEY=
# Set only after UNIQUE(revisionKey), append-only owner RLS and concurrency tests are verified.
VITE_BKEND_CONCURRENCY=

# Set to / when publishing at the domain root. Omit for the local development path.
DEPLOY_BASE_PATH=
